# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional model overrides
GROQ_REASON_MODEL=llama-3.3-70b-versatile
GROQ_BASE_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangSmith tracing (https://smith.langchain.com)
# When LANGSMITH_TRACING=true, every LangGraph node + LLM call is auto-traced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=ai-invoice-auditor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Chroma Cloud (https://www.trychroma.com)
# Leave unset to fall back to local persistent Chroma in docDB/.
CHROMA_API_KEY=ck-your_key_here
CHROMA_TENANT=your_tenant_uuid_here
CHROMA_DATABASE=invoice-auditor

# Supabase (https://supabase.com) — Postgres for reports + Storage for PDF blobs.
# All five are required; the app will refuse to start without them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJ_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres.xxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres
SUPABASE_BUCKET=invoices
